# Supabase (Section 4 — data warehouse)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase secret/service-role key — SERVER-SIDE USE ONLY.
# Do NOT prefix with VITE_ — that would ship it to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider for the insight-engine narrative layer (Section 5.1)
ANTHROPIC_API_KEY=

# Meta Ads API (Section 3.2)
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_ACCESS_TOKEN=
META_ADS_AD_ACCOUNT_ID=

# Shared secret the frontend sends to the `ad-spend-write` Edge Function
# (Section 3.2) — a low bar, not real access control. Same value must also
# be set as a function secret: npx supabase secrets set AD_SYNC_SHARED_SECRET=<value>
VITE_AD_SYNC_SHARED_SECRET=

# Google Ads API (Section 3.2)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
